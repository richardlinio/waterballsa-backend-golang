# Server Configuration
SERVER_PORT=8080
# SERVER_HOST=0.0.0.0                  # Optional: Default 0.0.0.0
# SERVER_READ_TIMEOUT=10s              # Optional: Default 10s
# SERVER_WRITE_TIMEOUT=10s             # Optional: Default 10s
# SERVER_SHUTDOWN_TIMEOUT=5s           # Optional: Default 5s
# SERVER_REQUEST_TIMEOUT=10s           # Optional: Default 10s
# GIN_MODE=debug                       # Optional: debug, release, test (Default: debug)

# Database Configuration (Required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=waterballsa
# DB_SSLMODE=disable                   # Optional: Default disable
# DB_MAX_CONNS=10                      # Optional: Default 10
# DB_MIN_CONNS=2                       # Optional: Default 2
# DB_TRANSACTION_TIMEOUT=5s            # Optional: Timeout for database transactions (Default: 5s)

# JWT Configuration (Required)
# IMPORTANT: JWT_SECRET must be at least 32 characters for security
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
# JWT_ACCESS_TOKEN_TIMEOUT=15m         # Optional: Access token validity (Default: 15m)
# JWT_REFRESH_TOKEN_TIMEOUT=168h       # Optional: Refresh token validity (Default: 168h = 7 days)
# JWT_SECURE_COOKIE=false              # Optional: Enable HTTPS-only cookies (Default: false, set to true in production)
# JWT_COOKIE_DOMAIN=                   # Optional: Cookie domain (e.g., .example.com)
# JWT_REALM=API                        # Optional: Bearer realm for authentication (Default: API)
# JWT_ACCESS_TOKEN_COOKIE_NAME=access_token   # Optional: Cookie name for access token (Default: access_token)
# JWT_REFRESH_TOKEN_COOKIE_NAME=refresh_token # Optional: Cookie name for refresh token (Default: refresh_token)
# JWT_REFRESH_COOKIE_PATH=/auth/refresh       # Optional: Cookie path for refresh token (Default: /auth/refresh)

# Logger Configuration
# LOG_LEVEL=info                       # Optional: debug, info, warn, error (Default: info)
# LOG_FORMAT=text                      # Optional: json, text (Default: text)

# CORS Configuration (Required)
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://your-production-domain.com,https://your-staging-domain.com
# CORS_ALLOW_CREDENTIALS=true          # Optional: Default true
# CORS_MAX_AGE_SECONDS=3600            # Optional: Default 3600 (1 hour)

# Rate Limiting Configuration
# RATE_LIMIT_ENABLED=true              # Optional: Enable rate limiting (Default: true)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60    # Optional: Max requests per IP per minute (Default: 60)
# RATE_LIMIT_WINDOW_DURATION=1m        # Optional: Time window for rate limiting (Default: 1m)
# RATE_LIMIT_CLEANUP_INTERVAL=5m       # Optional: Interval to cleanup expired records (Default: 5m)
# RATE_LIMIT_RECORD_EXPIRY=2m          # Optional: Expiry time for inactive IP records (Default: 2m)

